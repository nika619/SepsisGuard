# SepsisGuard AI — Environment Variables
# Copy this file to .env and fill in your values

# Your Anthropic API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API key that Prompt Opinion will send to authenticate with your server
# You will enter this same value in the platform's "API Key Header Value" field
SEPSISGUARD_API_KEY=sepsisguard-secret-2026

# Port to run the server on (default 8000)
PORT=8000
